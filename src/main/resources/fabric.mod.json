{
	"schemaVersion": 1,
	"id": "aynthor_secondscreen_v1_21",
	"version": "${version}",
	"name": "AYN Thor Second Screen",
	"description": "Moves Minecraft's HUD to the AYN Thor's bottom screen. Hides the vanilla HUD and streams health, hunger, armor, breath, XP, the hotbar, a live map, the open inventory and chat over a loopback socket to the companion Android app, which draws them with the game's own textures and sends taps, key binds and chat back.",
	"authors": [
		"exojosh"
	],
	"contact": {
		"homepage": "https://github.com/exojosh/AynThorSecondScreen",
		"sources": "https://github.com/exojosh/AynThorSecondScreen",
		"issues": "https://github.com/exojosh/AynThorSecondScreen/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/aynthor_secondscreen_v1_21/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.exojosh.Aynthor_secondscreen_v1_21"
		],
		"client": [
			"com.exojosh.client.Aynthor_secondscreen_v1_21Client",
			"com.exojosh.client.ThorHudClient"
		]
	},
	"mixins": [
		"aynthor_secondscreen_v1_21.mixins.json",
		{
			"config": "aynthor_secondscreen_v1_21.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
